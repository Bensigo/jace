{
  "name": "@heyjace/platform",
  "version": "0.1.3",
  "description": "Open-source trust layer for agents: intent, approval, verification, evidence and a local Console.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "!apps/jace",
    "packages/*"
  ],
  "scripts": {
    "test": "pnpm --filter @agentrail/mcp test && pnpm --filter @agentrail/console exec vitest run --maxWorkers=2 && npm --prefix apps/jace test",
    "typecheck": "pnpm --filter @agentrail/console typecheck",
    "typecheck:python": "bash agentrail/scripts/typecheck-python",
    "build": "pnpm --filter @agentrail/console build",
    "predev": "pnpm --filter @agentrail/db-postgres --filter @agentrail/github-app --filter @agentrail/mcp build",
    "dev": "pnpm --parallel --filter @agentrail/console --filter @agentrail/db-postgres --filter @agentrail/mcp dev",
    "lint": "pnpm --filter @agentrail/console lint",
    "db:generate": "pnpm --filter @agentrail/db-postgres db:generate",
    "db:migrate": "pnpm --filter @agentrail/db-postgres db:migrate && pnpm --filter @agentrail/db-clickhouse db:migrate",
    "db:migrate:pg": "pnpm --filter @agentrail/db-postgres db:migrate",
    "db:migrate:ch": "pnpm --filter @agentrail/db-clickhouse db:migrate",
    "db:seed": "pnpm --filter @agentrail/db-postgres db:seed && pnpm --filter @agentrail/db-clickhouse db:seed",
    "db:seed:pg": "pnpm --filter @agentrail/db-postgres db:seed",
    "db:seed:ch": "pnpm --filter @agentrail/db-clickhouse db:seed",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:open": "node scripts/local.mjs open",
    "local:status": "node scripts/local.mjs status",
    "pretest": "pnpm --filter @agentrail/github-app build && pnpm --filter @agentrail/db-postgres build && pnpm --filter @agentrail/mcp build && pnpm --filter @agentrail/console exec fumadocs-mdx",
    "test:compat": "python3 -m pytest -q -m \"not integration\""
  },
  "private": true
}
